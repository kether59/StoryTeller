{
  "name": "storyteller",
  "version": "2.0.0",
  "description": "Outil de gestion et d'écriture de romans avec assistance IA",
  "main": "electron/main.js",
  "author": "kether59",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build:frontend": "cd frontend && npm install && npm run build",
    "build:backend": "python build_backend.py",
    "build:electron": "electron-builder --win",
    "build:all": "npm run build:frontend && npm run build:backend && npm run build:electron",
    "dev": "electron . --dev"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.kether59.storyteller",
    "productName": "StoryTeller",
    "copyright": "Copyright © 2024 kether59",
    "icon": "electron/assets/icon.ico",
    "directories": {
      "output": "dist-electron",
      "buildResources": "electron/assets"
    },
    "files": [
      "electron/**/*",
      "!electron/assets/icon-source.*"
    ],
    "extraResources": [
      {
        "from": "backend/dist/StoryTellerBackend",
        "to": "backend",
        "filter": ["**/*"]
      },
      {
        "from": "frontend/dist",
        "to": "frontend-static",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "electron/assets/icon.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "installerIcon": "electron/assets/icon.ico",
      "uninstallerIcon": "electron/assets/icon.ico",
      "installerHeader": "electron/assets/installer-header.bmp",
      "installerSidebar": "electron/assets/installer-sidebar.bmp",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "StoryTeller",
      "include": "electron/installer.nsh",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "publish": null
  }
}